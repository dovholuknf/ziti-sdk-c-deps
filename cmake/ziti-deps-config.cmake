# Defines ziti-deps::ziti, the static libziti and everything it links, for the prefix this file ships in.
get_filename_component(_zd_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

if (NOT TARGET ziti-deps::ziti)
    add_library(ziti-deps::ziti INTERFACE IMPORTED)
    if (WIN32)
        set(_zd_libs ziti tlsuv stc libuv libssl libcrypto libsodium json-c protobuf-c llhttp zlib)
        set(_zd_prefix_lib "")
        set(_zd_suffix_lib ".lib")
    else ()
        set(_zd_libs ziti tlsuv stc uv ssl crypto sodium json-c protobuf-c llhttp z)
        set(_zd_prefix_lib "lib")
        set(_zd_suffix_lib ".a")
    endif ()
    set(_zd_files "")
    foreach (_zd_lib IN LISTS _zd_libs)
        list(APPEND _zd_files "${_zd_prefix}/lib/${_zd_prefix_lib}${_zd_lib}${_zd_suffix_lib}")
    endforeach ()
    if (WIN32)
        set(_zd_system "ws2_32;crypt32;iphlpapi;userenv;psapi;user32;advapi32;bcrypt;ncrypt;secur32;dbghelp;ole32;shell32")
    elseif (APPLE)
        set(_zd_system "-framework CoreFoundation;-framework Security;pthread;dl;m")
    else ()
        set(_zd_system "pthread;dl;m")
    endif ()
    if (MSVC)
        # the SDK headers use ##__VA_ARGS__, which MSVC only accepts with the conforming preprocessor
        set_property(TARGET ziti-deps::ziti PROPERTY INTERFACE_COMPILE_OPTIONS "/Zc:preprocessor")
        # ziti_log.h has an ERROR level that wingdi.h would otherwise redefine
        set_property(TARGET ziti-deps::ziti PROPERTY INTERFACE_COMPILE_DEFINITIONS NOGDI)
    endif ()
    set_target_properties(ziti-deps::ziti PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${_zd_prefix}/include"
            INTERFACE_LINK_LIBRARIES "${_zd_files};${_zd_system}")
endif ()
